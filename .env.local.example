# Copy to .env.local and fill in
ANTHROPIC_API_KEY=sk-ant-...

# --- Optional: email the finished report (SMTP via nodemailer) ---
# Leave SMTP_USER/SMTP_PASS unset to disable the feature; the app then rejects
# submissions that ask for email instead of silently dropping them.
#
# Gmail: enable 2FA, then create an App Password (16 chars, no spaces) at
# https://myaccount.google.com/apppasswords — your normal password will NOT work.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM=AutoAudit <you@gmail.com>

# Only set this if the app is reachable at a public URL — it adds a
# "view the interactive report" link to the email. Omit for local-only runs.
# APP_BASE_URL=https://autoaudit.example.com
