# Copy to .env.local and fill in.
# On Vercel, set the same variables in Project Settings -> Environment Variables.

# --- Required ---
ANTHROPIC_API_KEY=sk-ant-...

# Signs findings between the stateless /api/scan and /api/verify requests. The
# browser holds findings between those calls, so without this signature a caller
# could post invented findings and have them "verified". Generate with:
#   openssl rand -hex 32
FINDINGS_SIGNING_SECRET=

# --- Spend limits (strongly recommended on a public URL) ---
# Every audit costs real Anthropic credit, so the ceiling is on audits started.
# These are per serverless instance, so treat them as a brake, not a hard cap.
AUDIT_IP_LIMIT=3
AUDIT_DAILY_LIMIT=25

# --- Optional: email the finished report (SMTP via nodemailer) ---
# Leave SMTP_USER/SMTP_PASS unset to hide the feature entirely.
# Gmail: enable 2FA, then create an App Password (16 chars, no spaces) at
# https://myaccount.google.com/apppasswords — a normal password will NOT work.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=AutoAudit <you@gmail.com>

# --- Optional ---
# Raises GitHub's API rate limit from 60/hr per IP to 5000/hr. Worth setting on
# Vercel, where many deployments share an outbound IP. Needs no scopes.
# GITHUB_TOKEN=

# Adds a "view the interactive report" link to emails. Set to your deployment URL.
# APP_BASE_URL=https://your-app.vercel.app

# Forces the serverless (pure-JS, no binaries) code path locally, to reproduce
# exactly what the hosted deployment does. Vercel sets VERCEL=1 itself.
# AUTOAUDIT_JS_ONLY=1
